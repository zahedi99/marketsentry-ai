# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
# Variables are added here as each build step needs them.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://marketsentry:marketsentry@localhost:5432/marketsentry

# --- Market data providers (step 3) ------------------------------------------
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

# --- LLM providers (step 8) --------------------------------------------------
ANTHROPIC_API_KEY=

# --- Sleep window (when overnight capture runs) -------------------------------
USER_TIMEZONE=Europe/London
SLEEP_START=23:00
WAKE_TIME=07:00

# --- App ---------------------------------------------------------------------
LOG_LEVEL=INFO
